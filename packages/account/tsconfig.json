{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    // Both applications reach the account server through the runtime's own `fetch`, so the
    // types for it come from the DOM library rather than from a dependency. The wire format
    // package deliberately does not have these: it describes bytes, and nothing in it should
    // be able to open a socket.
    "lib": ["ES2023", "DOM"]
  },
  "include": ["src/**/*.ts"]
}
