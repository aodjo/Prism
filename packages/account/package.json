{
  "name": "@prism/account",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./holder": {
      "types": "./src/holder.ts",
      "default": "./dist/holder.js"
    },
    "./stored-session": {
      "types": "./src/stored-session.ts",
      "default": "./dist/stored-session.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "typescript": "^5.9.3"
  }
}
