{
  "compilerOptions": {
    // The panel runs in a browser, not in Node: no module system to speak of, no Node types,
    // and a DOM. Compiling it with the main process's settings would let a Node import through
    // that fails only at run time, in a window with no console anybody is watching.
    "target": "ES2023",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "outDir": "renderer",
    "rootDir": "src",
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": ["src/panel.ts", "src/api.d.ts"]
}
