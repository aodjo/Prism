{
  "name": "@prism/host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run build:css && pnpm run build:renderer",
    "build:css": "tailwindcss -i src/styles.css -o renderer/prism.css",
    "build:renderer": "esbuild src/panel.tsx --bundle --format=esm --outdir=renderer --target=chrome124 --jsx=automatic --sourcemap --define:process.env.NODE_ENV=\\\"production\\\"",
    "start": "pnpm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "@prism/native": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@prism/design": "workspace:*",
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "electron": "^44.2.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
