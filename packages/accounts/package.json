{
  "name": "@prism/accounts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "pnpm run build && wrangler dev",
    "migrate": "node scripts/migrate.mjs --remote",
    "operator": "node scripts/operator.mjs",
    "schema": "wrangler d1 execute prism-accounts --remote --file schema.sql",
    "tail": "wrangler tail",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.0.0"
  }
}
