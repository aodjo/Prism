{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prism-accounts",

  // Which Cloudflare account this belongs to. An identifier rather than a credential — it names
  // the account, it does not open it.
  //
  // Written down because wrangler refuses to guess: a login that can reach more than one account
  // and no answer here is a deploy that stops and asks, which is a deploy that cannot run
  // unattended. Guessing on the operator's behalf is worse — the wrong choice puts a second copy
  // of this Worker under an account nobody is watching, serving nobody, while the real one goes
  // on running the version before.
  "account_id": "371cd63a2c00cb8c3d2990060c1fb0b8",

  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // One way in. A `workers.dev` address would be a second name serving the same accounts, which
  // is a second thing to remember exists and nothing anybody needs.
  "workers_dev": false,
  "preview_urls": false,

  // Two names, one Worker.
  //
  // `accounts.presm.kr` is what the machines already know. Signalling keeps its own name, which
  // resolves to every region — this one must resolve to one place, because accounts are state
  // and a request that landed on a different copy would be told the account does not exist.
  //
  // `admin.presm.kr` is what a person opens. It is the same Worker rather than a deployment of
  // its own so that the dashboard and the API it calls share an origin: a separate host would
  // need CORS, and the page's content policy would have to name somewhere it may talk to.
  "routes": [
    { "pattern": "accounts.presm.kr", "custom_domain": true },
    { "pattern": "admin.presm.kr", "custom_domain": true }
  ],

  "d1_databases": [
    {
      "binding": "prism_accounts",
      "database_name": "prism-accounts",
      "database_id": "7e2e8dc2-cf3a-4c01-8649-81f3296f047d"
    }
  ],

  // Where signed-in machines should look for signalling. The NAME, so a region added later is
  // one that existing installations start using without being updated.
  "vars": {
    "PRISM_ADVERTISE": "rv.presm.kr:47300"
  }

  // PRISM_RESEND_KEY and PRISM_MAIL_FROM are secrets rather than vars, set with
  // `wrangler secret put`. Without the first, an address is only ever a name here: anybody can
  // register any address without proving it is theirs. Fine for your own machines; not for a
  // server strangers can reach.
  //
  // There is no admin token. Looking after this server is a column on an account, granted with
  // `pnpm --filter @prism/accounts operator <address>` from the machine that owns the database.
  //
  // The signalling regions are rows in `regions`, not a variable here, because the traffic
  // allowance on each is a number the operator changes from the dashboard.
}
