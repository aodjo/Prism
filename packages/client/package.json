{
  "name": "@prism/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:css && pnpm run build:renderer && pnpm run build:bridge",
    "build:bridge": "esbuild src/bridge.ts --bundle --format=iife --outfile=renderer/bridge.js --target=safari17 --sourcemap",
    "build:css": "tailwindcss -i src/styles.css -o renderer/prism.css",
    "build:renderer": "esbuild src/setup.tsx src/home.tsx src/panel.tsx --bundle --format=esm --outdir=renderer --target=safari17 --jsx=automatic --sourcemap --define:process.env.NODE_ENV=\\\"production\\\"",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@prism/design": "workspace:*",
    "@tailwindcss/cli": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
