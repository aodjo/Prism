{
  "name": "@prism/native",
  "version": "0.0.0",
  "private": true,
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "prism",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --manifest-path ../../crates/prism-napi/Cargo.toml --package-json-path package.json --output-dir .",
    "build:debug": "napi build --platform --manifest-path ../../crates/prism-napi/Cargo.toml --package-json-path package.json --output-dir ."
  }
}
