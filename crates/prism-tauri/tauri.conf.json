{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prism",
  "version": "0.1.0",
  "identifier": "dev.prism.client",
  "build": {
    "frontendDist": "../../packages/client/renderer"
  },
  "app": {
    "windows": [
      {
        "label": "home",
        "url": "home.html",
        "title": "Prism",
        "width": 1280,
        "height": 800,
        "minWidth": 1040,
        "minHeight": 720,
        "titleBarStyle": "Overlay",
        "backgroundColor": "#08080b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false
  }
}
