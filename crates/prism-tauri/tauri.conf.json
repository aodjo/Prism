{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prism",
  "version": "1.0.0-local.7",
  "identifier": "dev.prism.client",
  "build": {
    "frontendDist": "../../packages/client/renderer",
    "beforeBuildCommand": "node scripts/sidecar.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/local/icon.png",
      "icons/local/icon.ico",
      "icons/local/icon.icns"
    ],
    "externalBin": [
      "sidecar/prism-stream"
    ],
    "copyright": "Prism",
    "category": "Utility",
    "macOS": {
      "signingIdentity": "-"
    },
    "shortDescription": "Low-latency remote desktop",
    "longDescription": "Watch and control another machine, at a latency you can play a game through.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFRDgwNEQ0MTk0NjRCRkIKUldUN1MwWVoxQVRZVHBqNFp5ZDdHWDMwclFMK04vdTVoejNtcWFrcGtvNDU1cTJwWnlNSmgxQm4K",
      "endpoints": [
        "https://accounts.presm.kr/v1/update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
