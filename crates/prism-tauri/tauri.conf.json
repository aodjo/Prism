{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prism",
  "version": "0.1.0",
  "identifier": "dev.prism.client",
  "build": {
    "frontendDist": "../../packages/client/renderer",
    "beforeBuildCommand": "node scripts/sidecar.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "appimage"],
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "resources": ["sidecar/*"],
    "copyright": "Prism",
    "category": "Utility",
    "macOS": {
      "signingIdentity": "-"
    },
    "shortDescription": "Low-latency remote desktop",
    "longDescription": "Watch and control another machine, at a latency you can play a game through."
  }
}
