{
  "name": "prism",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm run build:native && pnpm -r --filter '!@prism/native' build",
    "build:native": "pnpm --filter @prism/native build",
    "build:native:debug": "pnpm --filter @prism/native build:debug",
    "client": "pnpm --filter @prism/client start",
    "client:setup": "pnpm --filter @prism/client start:setup",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings && cargo fmt --check",
    "lint:cross": "cargo clippy --workspace --exclude prism-rendezvous --all-targets --target x86_64-unknown-linux-gnu -- -D warnings && cargo clippy --workspace --exclude prism-rendezvous --exclude prism-cli --all-targets --target x86_64-pc-windows-msvc -- -D warnings",
    "smoke:electron": "electron scripts/electron-smoke.cjs",
    "smoke:node": "node scripts/node-smoke.cjs",
    "test": "pnpm -r test && pnpm run typecheck && cargo test --workspace",
    "test:rs": "cargo test --workspace",
    "test:ts": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.5.0",
    "electron": "^44.2.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.18.0"
}
