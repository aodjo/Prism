# Copy to `.env` beside this file and fill in. `.env` is ignored by git and must stay that way:
# two of these are secrets, and one of them can send mail as you.

# What to call this region in a list of them. Cosmetic and unverified — the round trip beside it
# is measured by whoever is reading it, so a server that named itself wrongly has mislabelled a
# row and changed nothing else.
PRISM_REGION=Netherlands (Amsterdam)

# Where signed-in machines should look for signalling, handed out when somebody signs in.
#
# The NAME, not this server's address. Every region answers to it, and a machine configured with
# one region's address would stop finding hosts the moment a nearer region was added.
PRISM_RENDEZVOUS_NAME=rv.presm.kr:47300

# The name the account API is served under, which must resolve to THIS machine alone.
#
# Not the rendezvous name. That one deliberately resolves to every region, which is right for
# stateless signalling and wrong for a file of accounts on one disk.
PRISM_ACCOUNT_HOST=accounts.presm.kr

# Where the certificate authority writes if a renewal is failing. Not published anywhere.
PRISM_ACCOUNT_EMAIL=you@example.com

# The mail provider's key, which is what lets this server prove an address is somebody's.
#
# Leave empty and the server creates accounts already verified and says so at startup. That is
# right for a server one person runs for their own machines, and wrong for one anybody can reach.
PRISM_RESEND_KEY=

# The address confirmations come from, whose domain the provider must already hold.
PRISM_MAIL_FROM=Prism <no-reply@example.com>

# Lets whoever holds it list and delete accounts on this server. Leave empty and those endpoints
# do not exist, which is the default: a rendezvous server is not an administration console
# unless somebody says it is.
PRISM_ADMIN_TOKEN=
