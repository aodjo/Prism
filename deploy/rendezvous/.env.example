# Copy to `.env` beside this file and fill in. `.env` is ignored by git.
#
# Nothing here is a secret any more. Accounts moved to `packages/accounts` — a Worker over D1 at
# its own name — so a region keeps nothing, writes nothing, and needs no mail key, no admin
# token and no certificate.

# What to call this region in a list of them. Cosmetic and unverified — the round trip beside it
# is measured by whoever is reading it, so a server that named itself wrongly has mislabelled a
# row and changed nothing else.
PRISM_REGION=Netherlands (Amsterdam)

# Where signed-in machines should look for signalling, handed out by the account server when
# somebody signs in.
#
# The NAME, not this server's address. Every region answers to it, and a machine configured with
# one region's address would stop finding hosts the moment a nearer region was added.
PRISM_RENDEZVOUS_NAME=rv.presm.kr:47300
