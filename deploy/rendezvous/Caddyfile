# TLS for the account API, and nothing else.
#
# The name here has to resolve to this one machine. That is not a detail: the rendezvous name is
# deliberately several address records, one per region, because signalling servers are
# stateless introducers and any of them will do. Accounts are the opposite — they are a file on
# one disk, and a name that round-robins between regions would sign somebody in against
# whichever server answered and tell them their account does not exist on the next call.

{
	email {$PRISM_ACCOUNT_EMAIL}
}

{$PRISM_ACCOUNT_HOST} {
	encode zstd gzip

	# The account server speaks plain HTTP and expects to be behind exactly this. Everything
	# that matters crosses here: the value that signs somebody in, and the machines an account
	# knows about. What never crosses, on either side of the proxy, is anything that opens a
	# private key — that stays sealed under a secret derived from the password.
	reverse_proxy 127.0.0.1:47380

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	log {
		output stdout
		format console
	}
}
